# ===========================================================================
# 宁渡课堂 · Python 后端 环境变量模板
#
# 用法：复制为 .env，填好值即可（application 会读 backend/.env）。
# ⚠️ .env 已在 .gitignore 中，不要提交真实密钥。
#
# 变量名与 Java 版 application.yml 完全一致，旧的 .env 可以直接复用。
# ===========================================================================

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/mental_health_assistant?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_SIZE=10

# ---- JWT ----
# ⚠️ 生产必改：≥ 32 位，不足会直接抛异常
JWT_SECRET=dev-placeholder-secret-change-me-in-production-0123456789
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_HEADER=Authorization
JWT_TOKEN_PREFIX=Bearer

# ---- AI（变量名是 AI_API_KEY，不是 DEEPSEEK_API_KEY）----
# 这三项是"部署期默认值"：管理后台「API 管理」页保存的值会**优先于**这里的
# 环境变量（存 sys_config 表，保存即时生效不用重启）。留空则页面上必须配。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---- 服务 ----
SERVER_PORT=1236
LOG_LEVEL=INFO

# ---- 文件上传 ----
FILE_UPLOAD_DIR=uploads
FILE_ALLOWED_EXTS=jpg,jpeg,png,gif,webp,bmp,pdf,txt,doc,docx,xls,xlsx,mp4,mp3,wav
FILE_MAX_SIZE=5242880
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=10MB

# ---- 分页 ----
PAGE_MAX_LIMIT=100

# ---- 危机干预 ----
CRISIS_CONTACT=学校心理健康教育中心
CRISIS_FORCE_CARD=true
# 危机工单的主动触达地址。**留空则只在服务端日志里记录，不会通知到任何人。**
# 填企业微信/钉钉/飞书群机器人的 webhook 即可，格式兼容。
# 例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
CRISIS_WEBHOOK_URL=
